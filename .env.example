# VoiceSplitting PWA - Configurações de Ambiente (Vite) Exemplo
# Copie este arquivo para .env e preencha com suas credenciais reais do Google Cloud Console.

# Google OAuth 2.0 Client ID (Obtido no Google Cloud Console com escopos drive.file e drive.appdata)
VITE_GOOGLE_CLIENT_ID="seu_client_id_aqui.apps.googleusercontent.com"

# URL Base da API do Backend Python Demucs/Spleeter (Opcional se usar processamento ONNX local no browser)
VITE_API_BASE_URL="http://localhost:8000"

# URL do Modelo ONNX para Separação Neural de Stems (Opcional para override do modelo local)
VITE_ONNX_MODEL_URL=""
