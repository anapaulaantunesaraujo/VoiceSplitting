# =====================================================================
# VoiceSplitting - Configuração de Ambiente para Produção / VPS
# Copie este arquivo para .env no servidor: cp .env.example .env
# =====================================================================

# 1. PORTAS DO HOST (DOCKER) - ISOLAMENTO TOTAL
# Portas exclusivas para evitar conflitos com outros apps no mesmo servidor (ex: Gestão de Estoque)
PORT_FRONTEND=3050
PORT_BACKEND=8050
PORT_DB=5435

# 2. BANCO DE DADOS POSTGRESQL (ISOLADO)
DB_USER=voicesplit_user
DB_PASSWORD=TroqueEstaSenhaSegura123!
DB_NAME=voicesplit_db

# 3. SEGURANÇA E CORS
# Adicione aqui o seu subdomínio final (ex: https://vozes.apaa.tech) ou mantenha * para testes
CORS_ORIGINS="https://vozes.apaa.tech,http://localhost:3050"

# 4. GOOGLE OAUTH 2.0 (CLIENT ID)
# Obtenha no Google Cloud Console com as URIs de redirecionamento do seu subdomínio
VITE_GOOGLE_CLIENT_ID="1002258145056-trpsn5jm9b5ailsqtf3ls39cd57lkhq9.apps.googleusercontent.com"

# 5. URL BASE DA API
# Deixe vazio ou como /api para utilizar o proxy reverso interno do Nginx do container
VITE_API_BASE_URL="/api"

# 6. MODELO ONNX LOCAL / OVERRIDE (OPCIONAL)
VITE_ONNX_MODEL_URL=""
